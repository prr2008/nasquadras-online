{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nasquadras-online",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // Arquivos estáticos do app e do site (HTML/CSS/JS).
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Tudo passa pelo Worker: ele decide entre site, app e arquivos estáticos.
    "run_worker_first": true
  },

  // Endereços próprios. O domínio principal (nasquadras.online) entra aqui
  // quando o site sair do Squarespace.
  "routes": [
    { "pattern": "app.nasquadras.online", "custom_domain": true }
  ],
  // Mantém também o endereço nasquadras-online.<conta>.workers.dev (com rotas
  // configuradas, a Cloudflare o desliga se isto não estiver explícito).
  "workers_dev": true,
  "preview_urls": true,

  // Site público das coberturas: jogos e posts (esquema em schema.sql).
  "d1_databases": [
    { "binding": "DB", "database_name": "nasquadras-site", "database_id": "64ef9ee0-3c46-4a32-baec-64e0b753ca7a" }
  ],

  // Mídia enviada pelo app. Fica pública só pelo caminho /m/<chave aleatória>.
  // A que não foi para o site é apagada automaticamente depois de 24 horas.
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "nasquadras-media" }
  ],

  // Tokens do Threads, sessão do Bluesky e histórico de posts.
  "kv_namespaces": [
    { "binding": "KV", "id": "440d54be039f4138b2a747e91984b6f3" }
  ],

  // Valores que não são segredo ficam aqui, no repositório. Os segredos
  // (senhas e tokens) são cadastrados no painel da Cloudflare como "Secret"
  // — veja o README. Cada deploy pelo GitHub aplica exatamente estes vars.
  "vars": {
    "THREADS_APP_ID": "1028301390289634",
    "BLUESKY_HANDLE": "prr2008.bsky.social",
    // Canal do X (@prr2008) no Buffer: os posts agendados para o X vão para lá.
    "BUFFER_X_CHANNEL": "68d5bf2f64332ee3985c74c8"
  },
  // Não apaga variáveis criadas pelo painel quando o GitHub publica uma versão nova.
  "keep_vars": true,

  // A cada minuto: publica os posts agendados. Uma vez por dia (9h17 UTC):
  // renova o token do Threads e apaga mídia antiga.
  "triggers": { "crons": ["* * * * *", "17 9 * * *"] },

  "observability": { "enabled": true }
}
